# Sysimage-baked variant of the Julia runtime image.
#
# Stage 1 (`builder`) instantiates the project, runs the precompile workload,
# and produces /opt/julia_src/reopt_sysimage.so. This stage is large (>4GB)
# and slow (~20–30 min on a clean cache).
#
# Stage 2 (`runtime`) copies only the project, depot, and sysimage into a
# fresh Julia base image. Final image is the sysimage'd runtime.

# -----------------------------------------------------------------------------
# Stage 1: build the sysimage
# -----------------------------------------------------------------------------
FROM julia:1.11.2 AS builder

ARG NREL_ROOT_CERT_URL_ROOT=""
RUN set -x && if [ -n "$NREL_ROOT_CERT_URL_ROOT" ]; then \
      curl -fsSLk -o /usr/local/share/ca-certificates/nrel_root.crt "${NREL_ROOT_CERT_URL_ROOT}/nrel_root.pem" && \
      curl -fsSLk -o /usr/local/share/ca-certificates/nrel_xca1.crt "${NREL_ROOT_CERT_URL_ROOT}/nrel_xca1.pem" && \
      update-ca-certificates; \
    fi
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update && apt-get -y install git build-essential && \
    rm -rf /var/lib/apt/lists/* /var/lib/dpkg/*-old /var/cache/* /var/log/*
ENV JULIA_PKG_USE_CLI_GIT=true
ENV JULIA_NUM_THREADS=4
ENV XPRESS_JL_SKIP_LIB_CHECK=True

WORKDIR /opt/julia_src
COPY . .

# Instantiate the runtime project (resolves julia_src/Project.toml).
RUN julia --project=/opt/julia_src -e 'import Pkg; Pkg.instantiate()'

# Instantiate the sysimage build env (PackageCompiler only).
RUN julia --project=/opt/julia_src/sysimage -e 'import Pkg; Pkg.instantiate()'

# Trace the workload and write reopt_sysimage.so.
RUN julia --project=/opt/julia_src/sysimage /opt/julia_src/sysimage/build.jl

# -----------------------------------------------------------------------------
# Stage 2: minimal runtime
# -----------------------------------------------------------------------------
FROM julia:1.11.2 AS runtime

ARG NREL_ROOT_CERT_URL_ROOT=""
RUN set -x && if [ -n "$NREL_ROOT_CERT_URL_ROOT" ]; then \
      curl -fsSLk -o /usr/local/share/ca-certificates/nrel_root.crt "${NREL_ROOT_CERT_URL_ROOT}/nrel_root.pem" && \
      curl -fsSLk -o /usr/local/share/ca-certificates/nrel_xca1.crt "${NREL_ROOT_CERT_URL_ROOT}/nrel_xca1.pem" && \
      update-ca-certificates; \
    fi
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update && apt-get -y install git && \
    rm -rf /var/lib/apt/lists/* /var/lib/dpkg/*-old /var/cache/* /var/log/*

ENV JULIA_PKG_USE_CLI_GIT=true
ENV JULIA_NUM_THREADS=4
ENV XPRESS_JL_SKIP_LIB_CHECK=True

WORKDIR /opt/julia_src

# Pull the project files, the depot (compiled package cache), and the sysimage
# from the builder. The depot is necessary because the sysimage doesn't bundle
# every Julia stdlib's source — it expects the depot to be on disk at the
# usual path.
COPY --from=builder /opt/julia_src              /opt/julia_src
COPY --from=builder /root/.julia                /root/.julia

EXPOSE 8081

CMD ["julia", \
     "--sysimage=/opt/julia_src/reopt_sysimage.so", \
     "--project=/opt/julia_src", \
     "-e", "include(\"http.jl\")"]
